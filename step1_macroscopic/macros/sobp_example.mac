# SOBP from several weighted GPS sources -- SYNTAX EXAMPLE ONLY.
# The weights below are illustrative, not optimised. Generate a real SOBP
# macro with analysis/sobp_weights.py from a pristine_scan.mac basis.

/control/verbose 1
/run/verbose 1

/rbe/det/depth 40 cm
/rbe/det/width 40 cm
/rbe/det/maxStep 0.5 mm

/run/setCut 0.1 mm
/run/initialize

# Source 0 (the default one): highest energy, largest weight
/gps/source/intensity 1.0
/gps/particle proton
/gps/pos/type Beam
/gps/pos/centre 0 0 -1 cm
/gps/pos/sigma_x 3 mm
/gps/pos/sigma_y 3 mm
/gps/direction 0 0 1
/gps/ene/type Gauss
/gps/ene/mono 150 MeV
/gps/ene/sigma 0.75 MeV

# Each /gps/source/add creates a new source that must be fully configured
/gps/source/add 0.35
/gps/particle proton
/gps/pos/type Beam
/gps/pos/centre 0 0 -1 cm
/gps/pos/sigma_x 3 mm
/gps/pos/sigma_y 3 mm
/gps/direction 0 0 1
/gps/ene/type Gauss
/gps/ene/mono 140 MeV
/gps/ene/sigma 0.70 MeV

/gps/source/add 0.25
/gps/particle proton
/gps/pos/type Beam
/gps/pos/centre 0 0 -1 cm
/gps/pos/sigma_x 3 mm
/gps/pos/sigma_y 3 mm
/gps/direction 0 0 1
/gps/ene/type Gauss
/gps/ene/mono 130 MeV
/gps/ene/sigma 0.65 MeV

/gps/source/list

/rbe/score/depthBins 800
/rbe/score/spectrumDepthBins 200
/rbe/output/prefix output/sobp_example

/run/printProgress 10000
/run/beamOn 100000
